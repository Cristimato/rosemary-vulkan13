#version 450
layout(local_size_x=32) in;
shared uint sh[256];
layout(std430, binding=0) buffer B { uint d[]; };
layout(push_constant) uniform P { uint n; };
void main(){ for (uint i = gl_LocalInvocationID.x; i <= n; i += 32u) { sh[i & 255u] = d[i]; }
  barrier(); d[gl_LocalInvocationID.x] = sh[gl_LocalInvocationID.x]; }
