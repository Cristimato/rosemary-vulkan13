#version 450
#extension GL_EXT_nonuniform_qualifier : require
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer O { uint o[64]; };
layout(set = 0, binding = 1) uniform usamplerBuffer tb[4];
void main() { uint i = gl_LocalInvocationID.x % 4u; o[gl_LocalInvocationID.x] = texelFetch(tb[nonuniformEXT(i)], 0).x; }
