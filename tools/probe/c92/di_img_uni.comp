#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer O { uint o[64]; };
layout(set = 0, binding = 1) uniform sampler2D t[4];
// índice uniforme (laço): para testar partially bound e update-after-bind sem divergência
void main() {
    uint i = gl_LocalInvocationID.x % 4u, r = 0u;
    for (uint k = 0u; k < 4u; k++) if (k == i) r = uint(texelFetch(t[k], ivec2(0), 0).x * 255.0 + 0.5);
    o[gl_LocalInvocationID.x] = r;
}
