+	struct kbase_device *kbdev;
+	u32 version;
+	u32 features;
+	void *input;
+	void *output;
+	u32 group_num;
+	u32 group_stride;
+	u32 prfcnt_size;
+	u32 instr_features;
+	struct kbase_csf_cmd_stream_group_info *groups;
+};
