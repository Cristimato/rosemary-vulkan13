--- /dev/null
+++ b/drivers/gpu/mediatek/gpu_mali/mali_bifrost/mali-r49p1/include/linux/memory_group_manager.h
@@ -0,0 +1,226 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
