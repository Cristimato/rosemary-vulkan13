--- /dev/null
+++ b/drivers/gpu/mediatek/gpu_mali/mali_bifrost/mali-r49p1/drivers/gpu/arm/midgard/mali_kbase_dummy_job_wa.c
@@ -0,0 +1,403 @@
+// SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note
+/*
+ *
