--- /dev/null
+++ b/drivers/gpu/mediatek/gpu_mali/mali_bifrost/mali-r49p1/drivers/base/arm/protected_memory_allocator/protected_memory_allocator.c
@@ -0,0 +1,543 @@
+// SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note
+/*
+ *
+ * (C) COPYRIGHT 2019-2023 ARM Limited. All rights reserved.
+ *
