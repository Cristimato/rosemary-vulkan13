+	static int type##_quirks_set(void *data, u64 val)                                    \
+	{                                                                                    \
+		struct kbase_device *kbdev;                                                  \
+		kbdev = (struct kbase_device *)data;                                         \
+		kbdev->hw_quirks_##type = (u32)val;                                          \
+		trigger_reset(kbdev);                                                        \
+		return 0;                                                                    \
+	}                                                                                    \
+                                                                                             \
+	static int type##_quirks_get(void *data, u64 *val)                                   \
+	{                                                                                    \
