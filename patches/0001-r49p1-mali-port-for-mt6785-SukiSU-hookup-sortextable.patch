+static int
+kbase_api_kinstr_prfcnt_enum_info(struct kbase_file *kfile,
+				  struct kbase_ioctl_kinstr_prfcnt_enum_info *prfcnt_enum_info)
+{
+	return kbase_kinstr_prfcnt_enum_info(kfile->kbdev->kinstr_prfcnt_ctx, prfcnt_enum_info);
+}
