+		break;
+	case 12:
+		ret = decode_lut_element_lookup(min_rev, idx, lut_fault_source_tiler_w_t_major_12,
+						NELEMS(lut_fault_source_tiler_w_t_major_12));
+		break;
+	}
+	return ret;
+}
