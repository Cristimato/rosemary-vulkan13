+++ b/drivers/gpu/mediatek/gpu_mali/mali_bifrost/mali-r49p1/drivers/gpu/arm/midgard/csf/mali_kbase_csf_firmware_core_dump.c
@@ -0,0 +1,810 @@
+// SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note
+/*
