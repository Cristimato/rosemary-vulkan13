diff --git a/drivers/gpu/mediatek/gpu_mali/mali_bifrost/mali-r49p1/drivers/gpu/arm/midgard/platform/meson/mali_kbase_runtime_pm.c b/drivers/gpu/mediatek/gpu_mali/mali_bifrost/mali-r49p1/drivers/gpu/arm/midgard/platform/meson/mali_kbase_runtime_pm.c
