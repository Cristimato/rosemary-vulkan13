diff --git a/drivers/gpu/mediatek/gpu_mali/mali_bifrost/mali-r49p1/drivers/gpu/arm/midgard/tl/backend/mali_kbase_timeline_csf.c b/drivers/gpu/mediatek/gpu_mali/mali_bifrost/mali-r49p1/drivers/gpu/arm/midgard/tl/backend/mali_kbase_timeline_csf.c
