+static int kbase_api_get_ddk_version(struct kbase_context *kctx,
+				     struct kbase_ioctl_get_ddk_version *version)
+{
+	int ret;
+	int len = sizeof(KERNEL_SIDE_DDK_VERSION_STRING);
+
+	CSTD_UNUSED(kctx);
+
+	if (version->version_buffer == 0)
+		return len;
+
+	if (version->size < (u32)len)
+		return -EOVERFLOW;
