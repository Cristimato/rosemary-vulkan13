+++ b/drivers/gpu/mediatek/gpu_mali/mali_bifrost/mali-r49p1/include/uapi/gpu/arm/midgard/csf/mali_kbase_csf_ioctl.h
@@ -0,0 +1,715 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+/*
