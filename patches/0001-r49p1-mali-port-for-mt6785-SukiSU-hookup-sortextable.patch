diff --git a/drivers/gpu/mediatek/gpu_mali/mali_bifrost/mali-r49p1/drivers/gpu/arm/midgard/tests/include/kutf/kutf_mem.h b/drivers/gpu/mediatek/gpu_mali/mali_bifrost/mali-r49p1/drivers/gpu/arm/midgard/tests/include/kutf/kutf_mem.h
