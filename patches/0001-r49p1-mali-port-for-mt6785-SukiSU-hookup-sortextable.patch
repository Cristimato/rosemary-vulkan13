+					     kbdev->csf.gpu_idle_dur_count_no_modifier
+						     << GLB_IDLE_TIMER_CONFIG_NO_MODIFIER_SHIFT,
+					     GLB_IDLE_TIMER_CONFIG_NO_MODIFIER_MASK);
+
